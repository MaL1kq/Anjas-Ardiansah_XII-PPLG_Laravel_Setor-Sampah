# Ganti dengan koneksi PostgreSQL kamu (Neon, Supabase, Railway, atau lokal)
DATABASE_URL="postgresql://user:password@localhost:5432/setor_sampah?schema=public"

# Ambil dari: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-secret-acak"
NEXTAUTH_URL="http://localhost:3000"

# Kredensial admin awal, dipakai oleh prisma/seed.ts
SEED_ADMIN_EMAIL="admin@tpu.com"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ADMIN_NAME="Admin TPU"
